<button type="button"
        class="topbar-user-profile"
        aria-label="Open user menu"
        title="User menu">

    <!-- Avatar -->
    <span class="user-avatar">
        M
    </span>

    <!-- User Information -->
    <span class="user-details">

        <span class="user-name">
            Mr. Adnan
        </span>

        <span class="user-role">
            Head Office
        </span>

    </span>

    <!-- Dropdown Arrow -->
    <svg class="user-chevron"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true">

        <polyline points="6 9 12 15 18 9" />

    </svg>

</button>