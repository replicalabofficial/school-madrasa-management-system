    /* =========================================
       PERIOD TEXT
    ========================================= */

    private string PeriodText =>
        UserType switch
        {
            "branch-01" =>
                "Branch 01 · Mar–Aug 2025",

            "branch-02" =>
                "Branch 02 · Mar–Aug 2025",

            _ =>
                "Mar–Aug 2025"
        };


    /* =========================================
       INCOME LINE
    ========================================= */

    private string IncomePoints =>
        string.Join(
            " ",
            FinancialData.Select(
                (item, index) =>
                    $"{GetX(index)},{GetY(item.Income)}"
            )
        );


    /* =========================================
       EXPENSE LINE
    ========================================= */

    private string ExpensesPoints =>
        string.Join(
            " ",
            FinancialData.Select(
                (item, index) =>
                    $"{GetX(index)},{GetY(item.Expenses)}"
            )
        );


    /* =========================================
       X POSITION
    ========================================= */

    private double GetX(int index)
    {
        if (FinancialData.Count <= 1)
        {
            return 350;
        }

        return 35 +
               index *
               (630.0 / (FinancialData.Count - 1));
    }


    /* =========================================
       Y POSITION
    ========================================= */

    private double GetY(decimal value)
    {
        const double chartHeight = 260;

        double normalized =
            (double)(value / ChartMaxValue);

        normalized =
            Math.Clamp(
                normalized,
                0,
                1
            );

        return 280 -
               (normalized * chartHeight);
    }


    /* =========================================
       HOVER X
    ========================================= */

    private double GetHoverX(int index)
    {
        if (FinancialData.Count <= 1)
        {
            return 0;
        }

        return index *
               (700.0 / FinancialData.Count);
    }


    /* =========================================
       HOVER WIDTH
    ========================================= */

    private double GetHoverWidth()
    {
        if (FinancialData.Count <= 0)
        {
            return 700;
        }

        return 700.0 /
               FinancialData.Count;
    }


    /* =========================================
       TOOLTIP POSITION

Tooltip moves with selected month.
    ========================================= */

    private double TooltipLeft
    {
        get
        {
            if (FinancialData.Count <= 1)
            {
                return 50;
            }

            double percentage =
                ((double)SelectedIndex /
                (FinancialData.Count - 1)) * 100;

            return percentage;
        }
    }


    /* =========================================
       TOOLTIP STYLE

First / last month need special
       positioning so tooltip does not
       go outside the card.
    ========================================= */

    private string TooltipStyle
    {
        get
        {
            if (FinancialData.Count <= 1)
            {
                return "left:50%;transform:translateX(-50%);";
            }

            if (SelectedIndex == 0)
            {
                return "left:4%;transform:translateX(0);";
            }

            if (SelectedIndex == FinancialData.Count - 1)
            {
                return "left:96%;transform:translateX(-100%);";
            }

            return $"left:{TooltipLeft:F2}%;transform:translateX(-50%);";
        }
    }


    /* =========================================
       SELECT MONTH
    ========================================= */

    private void SelectMonth(int index)
    {
        if (index < 0 ||
            index >= FinancialData.Count)
        {
            return;
        }

        if (SelectedIndex == index)
        {
            return;
        }

        SelectedIndex = index;
    }


    /* =========================================
       AXIS FORMAT
    ========================================= */

    private string FormatAxisValue(decimal value)
    {
        if (value >= 1000)
        {
            return $"{value / 1000:0.#}K";
        }

        return value.ToString("0");
    }


    /* =========================================
       CURRENCY FORMAT
    ========================================= */

    private string FormatCurrency(decimal amount)
    {
        return $"Rs. {amount:N0}";
    }


    /* =========================================
       DATA MODEL
    ========================================= */

    private class FinancialItem
    {
        public string Month { get; set; } = string.Empty;

        public decimal Income { get; set; }

        public decimal Expenses { get; set; }
    }
}