@rendermode InteractiveServer

<div class="financial-overview">

    <!-- HEADER -->

    <div class="financial-header">
        <div>
            <h2>Monthly Financial Overview</h2>
            <p>@PeriodText</p>
        </div>
    </div>


    <!-- CHART -->

    <div class="chart-container">

        <!-- Y AXIS -->

        <div class="chart-y-axis">

            @for (int i = ChartDivisions; i >= 0; i--)
            {
                <span>@FormatAxisValue(i * AxisStep)</span>
            }

        </div>


        <!-- CHART AREA -->

        <div class="chart-area">

            <!-- GRID -->

            <div class="chart-grid">

                @for (int i = 0; i <= ChartDivisions; i++)
                {
                    <div></div>
                }

            </div>


            <!-- SVG -->

            <svg class="financial-chart"
                 viewBox="0 0 700 300"
                 preserveAspectRatio="none">

                <!-- EXPENSE LINE -->

                <polyline points="@ExpensesPoints"
                          fill="none"
                          stroke="#ef4444"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round" />


                <!-- INCOME LINE -->

                <polyline points="@IncomePoints"
                          fill="none"
                          stroke="#2563eb"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round" />


                <!-- HOVER AREAS -->
                @for (int i = 0; i < FinancialData.Count; i++)
                {
                    var index = i;

                    <rect class="chart-hover-zone"
                          x="@GetHoverX(index)"
                          y="0"
                          width="@GetHoverWidth()"
                          height="300"
                          fill="transparent"
                          style="pointer-events:all;"
                          @onmouseover="() => SelectMonth(index)" />


                    <!-- EXPENSE POINT -->

                    <circle class="chart-point expense-point @(SelectedIndex == index ? "selected-chart-point" : "")"
                            cx="@GetX(index)"
                            cy="@GetY(FinancialData[index].Expenses)"
                            r="@(SelectedIndex == index ? 7 : 4)" />


                    <!-- INCOME POINT -->

                    <circle class="chart-point income-point @(SelectedIndex == index ? "selected-chart-point" : "")"
                            cx="@GetX(index)"
                            cy="@GetY(FinancialData[index].Income)"
                            r="@(SelectedIndex == index ? 7 : 4)" />
                }

            </svg>


            <!-- MOVING TOOLTIP -->
            @if (FinancialData.Count > 0)
            {
                <div class="chart-tooltip"
                     style="@TooltipStyle">

                    <div class="tooltip-month">
                        @CurrentMonth.Month
                    </div>


                    <!-- EXPENSE -->

                    <div class="tooltip-row">

                        <span class="tooltip-dot expense"></span>

                        <span>Expenses</span>

                        <strong>
                            @FormatCurrency(CurrentMonth.Expenses)
                        </strong>

                    </div>


                    <!-- INCOME -->

                    <div class="tooltip-row">

                        <span class="tooltip-dot income"></span>

                        <span>Income</span>

                        <strong>
                            @FormatCurrency(CurrentMonth.Income)
                        </strong>

                    </div>

                </div>
            }


            <!-- MONTH LABELS -->

            <div class="chart-months">

                @foreach (var item in FinancialData)
                {
                    <span>@item.Month</span>
                }

            </div>

        </div>

    </div>


    <!-- LEGEND -->

    <div class="chart-legend">

        <div class="legend-item">
            <span class="legend-line expenses"></span>
            <span>Expenses</span>
        </div>

        <div class="legend-item">
            <span class="legend-line income"></span>
            <span>Income</span>
        </div>

    </div>

</div>


@code {

    /* =========================================
       ROLE
    ========================================= */

    [Parameter]
    public string UserType { get; set; } = "head-office";


    /* =========================================
       CHART SCALE

900K / 5 =
       180K per division

900K
       720K
       540K
       360K
       180K
       0
    ========================================= */

    private const decimal ChartMaxValue = 900000m;

    private const int ChartDivisions = 5;

    private decimal AxisStep =>
        ChartMaxValue / ChartDivisions;


    /* =========================================
       SELECTED MONTH
    ========================================= */

    private int SelectedIndex { get; set; } = 0;


    /* =========================================
       CURRENT MONTH
    ========================================= */

    private FinancialItem CurrentMonth
    {
        get
        {
            if (FinancialData.Count == 0)
            {
