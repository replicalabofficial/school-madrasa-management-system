@inject School_Madrasa_Management_System.Web.Services.StudentState StudentState

@implements IDisposable


<div class="dashboard-stats">

    @foreach (var stat in Stats)
    {
        <div class="stat-card">

            <div class="stat-card-content">
                <div class="stat-label">@stat.Label</div>
                <div class="stat-value">@stat.Value</div>

                @if (!string.IsNullOrWhiteSpace(stat.Change))
                {
                    <div class="stat-change">
                        @stat.Change
                    </div>
                }
            </div>

        </div>
    }

</div>


@code {

    [Parameter]
    public string UserType { get; set; } = "head-office";


    protected override void OnInitialized()
    {
        StudentState.OnChange += HandleStudentStateChanged;
    }


    private void HandleStudentStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }


