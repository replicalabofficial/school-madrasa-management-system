@inject School_Madrasa_Management_System.Web.Services.StudentState StudentState

@implements IDisposable


<div class="branch-overview">

    <!-- =========================================
         HEADER
    ========================================= -->

    <div class="branch-overview-header">

        <div>
            <h2 class="branch-overview-title">
                Branch Overview
            </h2>

            <p class="branch-overview-description">
                Overview of all active branches.
            </p>
        </div>

    </div>


    <!-- =========================================
         BRANCH CARDS
    ========================================= -->

    <div class="branch-grid">

        <!-- =====================================
             BRANCH 01
        ====================================== -->

        <div class="branch-card">

            <!-- CARD HEADER -->

            <div class="branch-card-header">

                <div class="branch-header-left">

                    <div class="branch-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <rect x="5" y="3.5"
                                  width="14"
                                  height="17"
                                  rx="1.5" />

                            <path d="M9 20.5V16h6v4.5" />

                            <path d="M9 7h1" />
                            <path d="M14 7h1" />

                            <path d="M9 10.5h1" />
                            <path d="M14 10.5h1" />

                            <path d="M9 14h1" />
                            <path d="M14 14h1" />

                        </svg>

                    </div>


                    <span class="branch-name">
                        Branch 01
                    </span>


                    <span class="branch-status">
                        Active
                    </span>

                </div>


                <a href="/branches"
                   class="branch-view-details">

                    <span>View Details</span>

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M9 5l7 7-7 7" />

                    </svg>

                </a>

            </div>


            <!-- CARD BODY -->

            <div class="branch-card-body">

                <div class="branch-stat-grid">

                    <div class="branch-stat">

                        <span class="branch-stat-label">
                            Students
                        </span>

                        <span class="branch-stat-value">
                            @StudentState.Branch01Students
                        </span>

                    </div>


                    <div class="branch-stat">

                        <span class="branch-stat-label">
                            Staff
                        </span>

                        <span class="branch-stat-value">
                            4
                        </span>

                    </div>


                    <div class="branch-stat">

                        <span class="branch-stat-label">
                            Fees Collected
                        </span>

                        <span class="branch-stat-value">
                            Rs. 6,500
                        </span>

                    </div>


                    <div class="branch-stat">

                        <span class="branch-stat-label">
                            Total Income
                        </span>

                        <span class="branch-stat-value">
                            Rs. 158K
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================
             BRANCH 02
        ====================================== -->

        <div class="branch-card">

            <!-- CARD HEADER -->

            <div class="branch-card-header">

                <div class="branch-header-left">

                    <div class="branch-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <rect x="5" y="3.5"
                                  width="14"
                                  height="17"
                                  rx="1.5" />

                            <path d="M9 20.5V16h6v4.5" />

                            <path d="M9 7h1" />
                            <path d="M14 7h1" />

                            <path d="M9 10.5h1" />
                            <path d="M14 10.5h1" />

                            <path d="M9 14h1" />
                            <path d="M14 14h1" />

                        </svg>

                    </div>


                    <span class="branch-name">
                        Branch 02
                    </span>


                    <span class="branch-status">
                        Active
                    </span>

                </div>


                <a href="/branches"
                   class="branch-view-details">

                    <span>View Details</span>

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M9 5l7 7-7 7" />

                    </svg>

                </a>

            </div>


            <!-- CARD BODY -->

            <div class="branch-card-body">

                <div class="branch-stat-grid">

                    <div class="branch-stat">

                        <span class="branch-stat-label">
                            Students
                        </span>

                        <span class="branch-stat-value">
                            @StudentState.Branch02Students
                        </span>

                    </div>


                    <div class="branch-stat">

                        <span class="branch-stat-label">
                            Staff
                        </span>

                        <span class="branch-stat-value">
                            4
                        </span>

                    </div>


                    <div class="branch-stat">

                        <span class="branch-stat-label">
                            Fees Collected
                        </span>

                        <span class="branch-stat-value">
                            Rs. 10,000
                        </span>

                    </div>


                    <div class="branch-stat">

                        <span class="branch-stat-label">
                            Total Income
                        </span>

                        <span class="branch-stat-value">
                            Rs. 187K
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@code {

    protected override void OnInitialized()
    {
        StudentState.OnChange += HandleStudentStateChanged;
    }


    private void HandleStudentStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }


    public void Dispose()
    {
        StudentState.OnChange -= HandleStudentStateChanged;
    }

}